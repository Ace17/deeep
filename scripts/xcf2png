#!/usr/bin/env python3
import sys
import os
import subprocess
from pathlib import Path

def print_usage():
    print("Usage: xcf2png <input_file.xcf> -o <output_file.png>")
    sys.exit(1)

def main():
    # Basic argument validation mimicking xcf2png syntax
    if len(sys.argv) < 4 or sys.argv[2] != "-o":
        print_usage()

    input_path = Path(sys.argv[1]).resolve()
    output_path = Path(sys.argv[3]).resolve()

    if not input_path.exists():
        print(f"Error: Input file '{input_path}' does not exist.")
        sys.exit(1)

    # Escape paths for GIMP's Scheme interpreter
    infile_escaped = str(input_path).replace("\\", "\\\\").replace('"', '\\"')
    outfile_escaped = str(output_path).replace("\\", "\\\\").replace('"', '\\"')

    # Scheme commands compatible with GIMP 3 batch mode
    # 1. Load the XCF file non-interactively
    # 2. Merge all visible layers to flatten the image
    # 3. Export as a standard PNG file
    # 4. Safely clean up and quit
    gimp_script = f"""
    (let* (
        (image (car (gimp-file-load RUN-NONINTERACTIVE "{infile_escaped}" "{infile_escaped}")))
        (drawable (car (gimp-image-merge-visible-layers image CLIP-TO-IMAGE)))
    )
    (gimp-file-save RUN-NONINTERACTIVE image "{outfile_escaped}" "{outfile_escaped}")
    (gimp-image-delete image)
    (gimp-quit 0)
    )
    """

    # Execute GIMP completely headless with no UI or flash screens
    cmd = ["gimp-console", "-n", "-i", "-d", "-f", "--batch-interpreter", "plug-in-script-fu-eval", "-b", gimp_script]

    try:
        subprocess.run(cmd, text=True, check=True)
    except Exception as e:
        sys.stderr.write(f"Conversion failed: {e}\n")
        sys.exit(e.returncode)

if __name__ == "__main__":
    main()

